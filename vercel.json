    { "source": "/nearshore-vs-offshore", "destination": "/blog/nearshore-vs-offshore", "permanent": true },
    { "source": "/services/eor", "destination": "/services/cor", "permanent": true },
    { "source": "/services/managed-team", "destination": "/services/dedicated-team", "permanent": true }
  ]
